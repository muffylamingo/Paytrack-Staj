# Bu örnek dosyadır (git'e girer). Kopyalayıp ".env" yap ve kendi bilgilerini yaz.
# Gerçek .env dosyası .gitignore sayesinde git'e YÜKLENMEZ (şifreler gizli kalır).
DATABASE_URL=postgresql+psycopg://KULLANICI:SIFRE@localhost:5432/VERITABANI

# --- Keycloak (kullanıcı doğrulama) ---
# Bu değerler docker-compose.yml ve keycloak/paytrack-realm.json ile uyumlu.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=paytrack
KEYCLOAK_CLIENT_ID=paytrack-frontend
# Sadece geliştirme için: true yaparsan token kontrolü atlanır. Üretimde ASLA true olmamalı.
AUTH_DISABLED=false
