{
  "realm": "paytrack",
  "enabled": true,
  "displayName": "PayTrack",
  "loginTheme": "paytrack",
  "internationalizationEnabled": true,
  "supportedLocales": ["tr", "en"],
  "defaultLocale": "tr",
  "accessTokenLifespan": 1800,
  "registrationAllowed": false,

  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "permanentLockout": false,
  "passwordPolicy": "length(8) and notUsername()",
  "sslRequired": "external",

  "roles": {
    "realm": [
      {
        "name": "paytrack-mudur",
        "description": "Tam yetki: silme, bütçe ve kur yönetimi dahil her şey"
      },
      {
        "name": "paytrack-muhasebe",
        "description": "Fatura oluşturma, düzenleme, ödeme ve dosya ekleme"
      },
      {
        "name": "paytrack-goruntuleyici",
        "description": "Sadece görüntüleme (salt okunur)"
      }
    ]
  },

  "clients": [
    {
      "clientId": "paytrack-frontend",
      "name": "PayTrack Frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5173/*"
      }
    }
  ],
  "users": [
    {
      "username": "stajyer",
      "enabled": true,
      "emailVerified": true,
      "firstName": "ODAKENT",
      "lastName": "Stajyer",
      "email": "stajyer@odakent.local",
      "credentials": [
        { "type": "password", "value": "paytrack123", "temporary": false }
      ],
      "realmRoles": ["paytrack-muhasebe"]
    },
    {
      "username": "mudur",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Finans",
      "lastName": "Müdürü",
      "email": "mudur@odakent.local",
      "credentials": [
        { "type": "password", "value": "paytrack123", "temporary": false }
      ],
      "realmRoles": ["paytrack-mudur"]
    },
    {
      "username": "izleyici",
      "enabled": true,
      "emailVerified": true,
